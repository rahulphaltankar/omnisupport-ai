# Copy to .env (git-ignored) and fill in. NEVER commit real keys.
# LLM provider: rules (offline deterministic fallback, default) | local_hf (local Hugging Face instruct model) | anthropic | openai_compat
LLM_PROVIDER=rules
# Model id for the chosen provider, e.g. Qwen/Qwen2.5-0.5B-Instruct (local_hf) or an Anthropic model id (anthropic)
MODEL_NAME=replace_with_course_approved_model
# Only needed for LLM_PROVIDER=anthropic. Leave as placeholder otherwise.
LLM_API_KEY=replace_with_your_key
LLM_TIMEOUT_S=60
LLM_MAX_NEW_TOKENS=200
# Optional: Hugging Face token for gated/private downloads (not needed for the models used here)
# HF_TOKEN=
# openai_compat = any OpenAI-style endpoint, including free tiers (e.g. Mistral La Plateforme, Groq, OpenRouter).
# LLM_PROVIDER=openai_compat
# LLM_BASE_URL=https://api.mistral.ai/v1
# MODEL_NAME=<a model your free plan allows>
# LLM_API_KEY=<your key>  (environment only; never commit)
# For free tiers set LLM_PRICE_IN_PER_MTOK=0 and LLM_PRICE_OUT_PER_MTOK=0 so the cost column reads 0 instead of unknown.
